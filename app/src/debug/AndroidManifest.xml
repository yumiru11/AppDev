<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 测试基建：compose-ui-test 的 createComposeRule（v1/v2）在 Robolectric 下经
         ActivityScenario 启动 androidx.activity.ComponentActivity，要求该 Activity
         出现在被测变体的合并 manifest 中（Robolectric PR #4736 起强制）。
         androidx compose ui-test-manifest artifact 即为此声明；core:testing 的
         debugApi 依赖只合入其自身 debug manifest，不透传到 app，故在此补声明。
         仅 debug 变体合入，release 不受影响。 -->
    <application>
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true" />
    </application>
</manifest>
