<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 测试基建：compose-ui-test 的 createComposeRule（v1/v2）在 Robolectric 下经
         ActivityScenario 启动 androidx.activity.ComponentActivity，要求该 Activity
         出现在被测变体的合并 manifest 中（Robolectric PR #4736 起强制）。
         androidx compose ui-test-manifest artifact 即为此声明；core:testing 的
         debugApi 依赖只合入其自身 debug manifest，不透传到 app，故在此补声明。
         仅 debug 变体合入，release 不受影响。 -->
    <application>
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true" />
        <!-- 原型入口（PROTOTYPE ONLY）：README A/B 对照，仅 debug 变体存在，release 不受影响 -->
        <activity
            android:name="com.yumiru11.githubapp.PrototypeActivity"
            android:exported="true"
            android:theme="@style/Theme.AppDev">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 截图登录接收器（DEBUG ONLY）：经 adb am start -e pat 注入只读 PAT →
             EncryptedTokenStorage，无界面、存完即 finish。release 不声明。 -->
        <activity
            android:name="com.yumiru11.githubapp.ScreenshotTokenReceiver"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true" />
    </application>
</manifest>
